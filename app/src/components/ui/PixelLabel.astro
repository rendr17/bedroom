---
interface Props {
  tone?: "default" | "accent" | "muted" | "ink";
  class?: string;
}

const { tone = "default", class: className } = Astro.props;
---

<span class:list={["pixel-label", `tone-${tone}`, className]}><slot /></span>

<style>
  .pixel-label {
    font-family: var(--mono-font);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tone-default {
    color: var(--text);
  }

  .tone-accent {
    color: var(--accent);
  }

  .tone-muted {
    color: var(--text);
    opacity: 0.85;
  }

  .tone-ink {
    color: var(--text-dark);
    opacity: 0.8;
  }
</style>
