---
import { NAV_LINKS } from "@/data/site";

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<nav class:list={["site-nav", embedded && "embedded"]} aria-label="Main navigation">
  <ul>
    {
      NAV_LINKS.map(({ href, label, icon }) => (
        <li>
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            <img src={icon} alt="" width="20" height="20" aria-hidden="true" />
            <span>{label}</span>
          </a>
        </li>
      ))
    }
    <li>
      <button
        type="button"
        id="sound-toggle"
        class="sound-toggle"
        aria-pressed="false"
        data-cue
        hidden
      >
        <img
          src="/assets/icons/system/muted.png"
          alt=""
          width="20"
          height="20"
          aria-hidden="true"
        />
        <span class="sr-only">Sound</span>
      </button>
    </li>
  </ul>
</nav>

<style>
  .site-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    background: var(--surface);
    border-top: 1px solid var(--border-dark);
    box-shadow: 0 -1px 0 var(--border-light) inset;
  }

  .site-nav.embedded {
    position: static;
    background: transparent;
    border-top: none;
    box-shadow: none;
  }

  .site-nav.embedded ul {
    padding: 0;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    justify-content: safe center;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1) var(--space-2);
    padding-bottom: calc(var(--space-1) + env(safe-area-inset-bottom, 0px));
    list-style: none;
    font-family: var(--ui-font);
    overflow-x: auto;
  }

  .site-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 56px;
    min-height: 44px;
    padding: var(--space-1) var(--space-2);
    color: var(--text);
    font-size: 0.68rem;
    text-decoration: none;
    border: 1px solid transparent;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .site-nav img {
    width: 20px;
    height: 20px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .site-nav a:hover {
    color: var(--accent);
    background: var(--bg-deep);
    border-color: var(--border-dark);
    box-shadow: var(--shadow-raised);
  }

  .site-nav a:active {
    box-shadow: var(--shadow-sunken);
  }

  .site-nav a[aria-current="page"] {
    color: var(--accent);
    background: var(--bg-deep);
    border-color: var(--border-dark);
    box-shadow: var(--shadow-sunken);
  }

  .sound-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-1) var(--space-2);
    font: inherit;
    color: var(--text);
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .sound-toggle:hover {
    color: var(--accent);
    background: var(--bg-deep);
    border-color: var(--border-dark);
    box-shadow: var(--shadow-raised);
  }

  .sound-toggle[aria-pressed="true"] {
    color: var(--accent);
    background: var(--bg-deep);
    border-color: var(--border-dark);
    box-shadow: var(--shadow-sunken);
  }

  .sound-toggle img {
    width: 20px;
    height: 20px;
    object-fit: contain;
    image-rendering: pixelated;
  }
</style>

<script>
  import { isSoundEnabled, setSoundEnabled, playCue } from "@/utils/audio";

  const toggle = document.getElementById(
    "sound-toggle",
  ) as HTMLButtonElement | null;
  const icon = toggle?.querySelector("img");

  const render = () => {
    const on = isSoundEnabled();
    toggle?.setAttribute("aria-pressed", String(on));
    if (icon) {
      icon.src = on
        ? "/assets/icons/system/sound.png"
        : "/assets/icons/system/muted.png";
    }
  };

  toggle?.removeAttribute("hidden");
  render();
  toggle?.addEventListener("click", () => {
    setSoundEnabled(!isSoundEnabled());
    render();
    playCue("click");
  });
</script>
