---
import SiteNav from "@/components/navigation/SiteNav.astro";
import { profile } from "@/data/profile";
---

<div class="adventure-bar">
  <div class="ab-cell ab-avatar">
    <img
      src="/assets/props/avatar-placeholder.png"
      alt="Pixel-art portrait of Rendi"
      width="56"
      height="56"
    />
  </div>
  <div class="ab-cell ab-dialog">
    <p class="ab-name">{profile.name}</p>
    <p class="ab-text" id="ab-line" aria-live="polite">
      Welcome to my little corner of the internet. Click around, explore, and
      discover my journey!
    </p>
    <button
      type="button"
      class="ab-next"
      id="ab-next"
      aria-label="Next message"
      data-cue
    >
      ▼
    </button>
  </div>
  <p class="ab-cell ab-motto">
    <span>Same Human.</span>
    <span>New Adventures.</span>
  </p>
  <div class="ab-cell ab-nav">
    <SiteNav embedded />
  </div>
</div>

<script>
  const line = document.getElementById("ab-line");
  const next = document.getElementById("ab-next");
  const lines = [
    "Welcome to my little corner of the internet. Click around, explore, and discover my journey!",
    "Tip: click a ! marker in the room to open a section — or use the icons over here.",
    "Quest progress is saved in your browser only. The cat is not a quest. Probably.",
  ];
  let index = 0;
  next?.addEventListener("click", () => {
    index = (index + 1) % lines.length;
    if (line) line.textContent = lines[index];
  });
</script>

<style>
  .adventure-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: stretch;
    gap: var(--space-1);
    padding: var(--space-1);
    background: var(--surface);
    border-top: 1px solid var(--border-dark);
    box-shadow: inset 0 1px 0 var(--border-light);
  }

  .ab-cell {
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    background: var(--bg-deep);
    box-shadow: var(--shadow-sunken);
  }

  .ab-avatar {
    padding: var(--space-1);
  }

  .ab-avatar img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    object-position: top;
    image-rendering: pixelated;
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
  }

  .ab-dialog {
    flex: 1 1 auto;
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "name next"
      "text next";
    column-gap: var(--space-2);
    align-items: center;
  }

  .ab-name {
    grid-area: name;
    font-family: var(--mono-font);
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .ab-text {
    grid-area: text;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .ab-next {
    grid-area: next;
    align-self: end;
    min-width: 28px;
    min-height: 24px;
    padding: 0 var(--space-1);
    font-size: 0.7rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    cursor: pointer;
  }

  .ab-next:active {
    box-shadow: var(--shadow-sunken);
  }

  .ab-motto {
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    font-family: var(--mono-font);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: var(--text);
    white-space: nowrap;
  }

  .ab-nav {
    padding: 0 var(--space-1);
  }

  @media (max-width: 820px) {
    .adventure-bar {
      flex-wrap: wrap;
    }

    .ab-motto {
      display: none;
    }

    .ab-nav {
      flex: 1 1 100%;
      order: 4;
    }

    .ab-nav :global(.site-nav ul) {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .ab-avatar img {
      width: 44px;
      height: 44px;
    }

    .ab-text {
      font-size: 0.75rem;
    }
  }
</style>
