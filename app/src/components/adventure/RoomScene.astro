---
import { hotspots } from "@/data/hotspots";
import RetroDialog from "@/components/ui/RetroDialog.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const primaryHotspots = hotspots.filter((h) => !h.optional);
const extraHotspots = hotspots.filter((h) => h.optional);
---

<figure class:list={["room-scene", className]}>
  <div class="room-stage">
    <img
      src="/assets/backgrounds/bedroom-night.png"
      alt="Pixel-art bedroom at night: a bed with a sleeping cat, a wooden desk holding a CRT monitor and a digital clock, a potted plant, a bookshelf, posters and a corkboard on the wall, and a window overlooking a city skyline."
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <nav class="room-hotspots" aria-label="Room">
      <ul>
        {
          primaryHotspots.map((h) => (
            <li
              style={`--hx:${h.desktop.x}%;--hy:${h.desktop.y}%;--o:${h.mobileOrder}`}
            >
              <a href={h.href} class="hotspot" data-section={h.id}>
                <img
                  class="hotspot-marker"
                  src="/assets/icons/system/hotspot.png"
                  alt=""
                  width="115"
                  height="133"
                  aria-hidden="true"
                />
                <span class="hotspot-label">{h.label}</span>
              </a>
            </li>
          ))
        }
        {
          extraHotspots.map((h) => (
            <li
              style={`--hx:${h.desktop.x}%;--hy:${h.desktop.y}%;--o:${h.mobileOrder}`}
            >
              <a href={h.href} class="hotspot" data-section={h.id}>
                <img
                  class="hotspot-marker marker-prop"
                  src={h.icon ?? "/assets/icons/system/hotspot.png"}
                  alt=""
                  width="240"
                  height="156"
                  aria-hidden="true"
                />
                <span class="hotspot-label">{h.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="room-eggs">
      <button
        type="button"
        class="hotspot egg"
        id="egg-cat"
        style="--hx:15%;--hy:63%;--o:7"
        aria-label="Pet the cat"
      >
        <img
          class="hotspot-marker"
          src="/assets/icons/system/hotspot.png"
          alt=""
          width="115"
          height="133"
          aria-hidden="true"
        />
        <span class="hotspot-label">Pet the cat</span>
      </button>
      <button
        type="button"
        class="hotspot egg"
        id="egg-floppy"
        style="--hx:74%;--hy:76%;--o:8"
        aria-label="Read the floppy disk"
        data-cue
      >
        <img
          class="hotspot-marker marker-prop"
          src="/assets/props/floppy.png"
          alt=""
          width="188"
          height="181"
          aria-hidden="true"
        />
        <span class="hotspot-label">Read the floppy</span>
      </button>
      <span class="cat-bubble" id="cat-bubble" aria-hidden="true"></span>
    </div>
  </div>
  <figcaption class="room-hint">
    Click a <b>!</b> marker in the room to explore — or use the navigation below.
  </figcaption>
</figure>
<p class="sr-only" id="cat-live" aria-live="polite"></p>

<RetroDialog id="readme-dialog" title="README.TXT">
  <p>
    <b>ABOUT_THIS_SITE.TXT</b> — recovered from a floppy on the desk:
  </p>
  <p>
    This room is a real website: semantic HTML, Astro, and TypeScript. No
    framework runtime in the browser, and quest progress is saved in
    localStorage only.
  </p>
  <p>
    The posters are real. The cat is asleep. You have found one of the three
    secrets hidden in this room — keep poking around.
  </p>
</RetroDialog>

<style>
  .room-scene {
    margin: var(--space-6) auto 0;
    max-width: min(100%, calc((100vh - 14rem) * 16 / 9));
    max-width: min(100%, calc((100dvh - 14rem) * 16 / 9));
    padding: var(--space-2);
    background: var(--surface);
    border: 2px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    animation: room-in 0.55s var(--ease-out) both;
  }

  @keyframes room-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .room-hint {
    padding: var(--space-2) var(--space-1) 0;
    font-family: var(--mono-font);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.85;
  }

  .room-hint b {
    color: var(--accent);
  }

  .room-stage {
    position: relative;
  }

  .room-stage > img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    image-rendering: pixelated;
    background: var(--bg-deep);
    display: block;
  }

  .room-hotspots {
    position: absolute;
    inset: 0;
  }

  .room-hotspots ul {
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hotspot {
    position: absolute;
    left: var(--hx);
    top: var(--hy);
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    text-decoration: none;
  }

  .hotspot-marker {
    width: 28px;
    height: 28px;
    object-fit: contain;
    image-rendering: pixelated;
    opacity: 0.7;
    animation: marker-glow 2.6s ease-in-out infinite;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out);
  }

  @keyframes marker-glow {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 0.95;
    }
  }

  .hotspot-label {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 8px;
    font-family: var(--mono-font);
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-dark);
    background: var(--accent);
    border: 1px solid var(--border-dark);
    opacity: 0;
    transform: translateX(-50%) translateY(4px);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .hotspot:hover .hotspot-marker,
  .hotspot:focus-visible .hotspot-marker {
    animation-play-state: paused;
    opacity: 1;
    transform: scale(1.15);
    filter: drop-shadow(0 0 6px rgb(255 209 102 / 0.8));
  }

  .hotspot:active .hotspot-marker {
    transform: scale(0.95);
    transition-duration: 0s;
  }

  .hotspot[data-visited]::after {
    content: "✓" / "";
    position: absolute;
    right: 0;
    bottom: 2px;
    font-family: var(--mono-font);
    font-size: 0.6rem;
    font-weight: bold;
    line-height: 1;
    color: var(--text-dark);
    background: var(--success);
    border: 1px solid var(--border-dark);
    padding: 1px 3px;
  }

  .hotspot[data-visited] .hotspot-marker {
    opacity: 0.5;
  }

  .hotspot[data-visited]:hover .hotspot-marker,
  .hotspot[data-visited]:focus-visible .hotspot-marker {
    opacity: 1;
  }

  .hotspot:hover .hotspot-label,
  .hotspot:focus-visible .hotspot-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .room-eggs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .room-eggs .egg {
    pointer-events: auto;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .room-eggs .hotspot-marker {
    opacity: 0.55;
  }

  .marker-prop {
    width: auto;
    height: 34px;
  }

  .cat-bubble {
    position: absolute;
    left: 15%;
    top: 63%;
    transform: translate(-50%, -160%) scale(0.9);
    padding: 4px 10px;
    font-family: var(--mono-font);
    font-size: 0.72rem;
    font-weight: bold;
    color: var(--text-dark);
    background: var(--window);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .cat-bubble.show {
    opacity: 1;
    transform: translate(-50%, -160%) scale(1);
  }

  @media (max-width: 640px) {
    .room-stage {
      display: flex;
      flex-direction: column;
    }

    .room-hotspots {
      position: static;
      margin-top: var(--space-2);
    }

    .room-hotspots ul,
    .room-eggs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      height: auto;
    }

    .room-eggs {
      position: static;
      margin-top: var(--space-2);
    }

    .room-hotspots li,
    .room-eggs .egg {
      order: var(--o);
    }

    .hotspot {
      position: relative;
      transform: none;
      width: auto;
      height: auto;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      min-height: 44px;
      color: var(--text);
      background: var(--bg-deep);
      border: 1px solid var(--border-dark);
      box-shadow: var(--shadow-raised);
    }

    .hotspot:active {
      box-shadow: var(--shadow-sunken);
    }

    .hotspot-marker {
      width: 20px;
      height: 20px;
      opacity: 1;
    }

    .hotspot-label {
      position: static;
      transform: none;
      padding: 0;
      color: var(--text);
      background: none;
      border: none;
      opacity: 1;
      pointer-events: auto;
    }

    .hotspot:hover .hotspot-marker,
    .hotspot:focus-visible .hotspot-marker {
      transform: none;
    }

    .hotspot:hover .hotspot-label,
    .hotspot:focus-visible .hotspot-label {
      color: var(--accent);
    }

    .cat-bubble {
      position: fixed;
      top: auto;
      bottom: calc(64px + var(--space-3));
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
    }

    .cat-bubble.show {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  import { playCue } from "@/utils/audio";
  import { getVisited, type QuestSection } from "@/utils/progress";

  const visited = new Set<QuestSection>(getVisited());
  document
    .querySelectorAll<HTMLElement>(".room-hotspots .hotspot[data-section]")
    .forEach((el) => {
      const id = el.getAttribute("data-section") as QuestSection | null;
      if (id && visited.has(id)) el.setAttribute("data-visited", "true");
    });

  const catBtn = document.getElementById("egg-cat");
  const catBubble = document.getElementById("cat-bubble");
  const catLive = document.getElementById("cat-live");
  const floppyBtn = document.getElementById("egg-floppy");
  const readmeDialog = document.getElementById("readme-dialog");

  const catLines = [
    "mrrp~",
    "purr…",
    "zzZzz",
    "…the cat pretends to sleep",
    "*tail flick*",
    "mew!",
  ];
  let catIndex = 0;
  let bubbleTimer: number | undefined;

  catBtn?.addEventListener("click", () => {
    const line = catLines[catIndex++ % catLines.length];
    if (catBubble) {
      catBubble.textContent = line;
      catBubble.classList.add("show");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(
        () => catBubble.classList.remove("show"),
        2400,
      );
    }
    if (catLive) catLive.textContent = `Cat: ${line}`;
  });

  if (readmeDialog instanceof HTMLDialogElement) {
    floppyBtn?.addEventListener("click", () => {
      playCue("open");
      readmeDialog.showModal();
    });
    readmeDialog.addEventListener("click", (event) => {
      if (event.target === readmeDialog) readmeDialog.close();
    });
  }
</script>
