---
import { hotspots } from "@/data/hotspots";
import RetroDialog from "@/components/ui/RetroDialog.astro";

interface Props {
  class?: string;
  cover?: boolean;
}

const { class: className, cover = false } = Astro.props;
const primaryHotspots = hotspots.filter((h) => !h.optional);
const extraHotspots = hotspots.filter((h) => h.optional);
---

<figure class:list={["room-scene", className, cover && "cover"]}>
  <div class="room-bg">
    <img
      src="/assets/backgrounds/bedroom-full.jpg"
      alt="Pixel-art bedroom at night: a bed with a sleeping cat, a wooden desk holding a CRT monitor showing a retro desktop, a keyboard, mug and notebook, a bookshelf, posters on the wall, and a window overlooking a city skyline."
      width="1024"
      height="768"
      fetchpriority="high"
    />
  </div>
  <div class="room-overlay">
    <nav class="room-hotspots" aria-label="Room">
      <ul>
        {
          primaryHotspots.map((h) => (
            <li
              style={`--hx:${h.desktop.x};--hy:${h.desktop.y};--o:${h.mobileOrder}`}
            >
              <a href={h.href} class="hotspot pin" data-section={h.id}>
                <img
                  class="hotspot-marker"
                  src="/assets/icons/system/hotspot.png"
                  alt=""
                  width="115"
                  height="133"
                  aria-hidden="true"
                />
                <span class="hotspot-label">{h.label}</span>
              </a>
            </li>
          ))
        }
        {
          extraHotspots.map((h) => (
            <li
              style={`--hx:${h.desktop.x};--hy:${h.desktop.y};--o:${h.mobileOrder}`}
            >
              <a href={h.href} class="hotspot pin" data-section={h.id}>
                <img
                  class="hotspot-marker marker-prop"
                  src={h.icon ?? "/assets/icons/system/hotspot.png"}
                  alt=""
                  width="240"
                  height="156"
                  aria-hidden="true"
                />
                <span class="hotspot-label">{h.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="room-eggs">
      <button
        type="button"
        class="hotspot pin egg"
        id="egg-cat"
        style="--hx:7;--hy:62;--o:7"
        aria-label="Pet the cat"
      >
        <img
          class="hotspot-marker"
          src="/assets/icons/system/hotspot.png"
          alt=""
          width="115"
          height="133"
          aria-hidden="true"
        />
        <span class="hotspot-label">Pet the cat</span>
      </button>
      <button
        type="button"
        class="hotspot pin egg"
        id="egg-floppy"
        style="--hx:92;--hy:80;--o:8"
        aria-label="Read the floppy disk"
        data-cue
      >
        <img
          class="hotspot-marker marker-prop"
          src="/assets/props/floppy.png"
          alt=""
          width="188"
          height="181"
          aria-hidden="true"
        />
        <span class="hotspot-label">Read the floppy</span>
      </button>
      <span
        class="cat-bubble pin"
        id="cat-bubble"
        style="--hx:11;--hy:53"
        aria-hidden="true"
      ></span>
    </div>
    <slot name="overlay" />
  </div>
  <figcaption class="room-hint sr-only">
    Click a <b>!</b> marker in the room to explore — or use the navigation below.
  </figcaption>
</figure>
<p class="sr-only" id="cat-live" aria-live="polite"></p>

<RetroDialog id="readme-dialog" title="README.TXT">
  <p>
    <b>ABOUT_THIS_SITE.TXT</b> — recovered from a floppy on the desk:
  </p>
  <p>
    This room is a real website: semantic HTML, Astro, and TypeScript. No
    framework runtime in the browser, and quest progress is saved in
    localStorage only.
  </p>
  <p>
    The posters are real. The cat is asleep. You have found one of the three
    secrets hidden in this room — keep poking around.
  </p>
</RetroDialog>

<style>
  .room-scene {
    position: relative;
    margin: var(--space-6) auto 0;
    max-width: min(100%, calc((100vh - 14rem) * 1024 / 630));
    max-width: min(100%, calc((100dvh - 14rem) * 1024 / 630));
    padding: var(--space-2);
    background: var(--surface);
    border: 2px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    animation: room-in 0.55s var(--ease-out) both;
  }

  @keyframes room-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .room-hint {
    padding: var(--space-2) var(--space-1) 0;
    font-family: var(--mono-font);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.85;
  }

  .room-hint b {
    color: var(--accent);
  }

  .room-bg {
    position: relative;
  }

  .room-bg img {
    width: 100%;
    aspect-ratio: 1024 / 768;
    object-fit: contain;
    image-rendering: pixelated;
    background: var(--bg-deep);
    display: block;
  }

  .room-overlay {
    position: absolute;
    inset: 0;
  }

  .room-hotspots {
    position: absolute;
    inset: 0;
  }

  .room-hotspots ul {
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pin {
    position: absolute;
    left: calc(var(--hx) * 1%);
    top: calc(var(--hy) * 1%);
  }

  .hotspot {
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px var(--space-2) 3px var(--space-1);
    min-height: 30px;
    color: var(--text-dark);
    background: var(--window);
    border: 1px solid var(--border-dark);
    box-shadow:
      var(--shadow-raised),
      var(--shadow-panel);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .hotspot-marker {
    flex: none;
    width: 18px;
    height: 18px;
    object-fit: contain;
    image-rendering: pixelated;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @keyframes marker-glow {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.95;
    }
  }

  .hotspot-label {
    font-family: var(--mono-font);
    font-size: 0.68rem;
    font-weight: bold;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hotspot:hover,
  .hotspot:focus-visible {
    background: var(--accent);
  }

  .hotspot:hover .hotspot-marker,
  .hotspot:focus-visible .hotspot-marker {
    transform: scale(1.2);
  }

  .hotspot:active {
    box-shadow: var(--shadow-sunken);
  }

  .hotspot[data-visited]::after {
    content: "✓" / "";
    position: absolute;
    top: -7px;
    right: -7px;
    font-family: var(--mono-font);
    font-size: 0.6rem;
    font-weight: bold;
    line-height: 1;
    color: var(--text-dark);
    background: var(--success);
    border: 1px solid var(--border-dark);
    padding: 1px 3px;
  }

  .room-eggs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .room-eggs .egg {
    pointer-events: auto;
    justify-content: center;
    gap: 0;
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    color: var(--text);
    background: none;
    border: none;
    box-shadow: none;
    font: inherit;
    cursor: pointer;
  }

  .room-eggs .egg .hotspot-marker {
    width: 28px;
    height: 28px;
    opacity: 0.55;
    animation: marker-glow 2.6s ease-in-out infinite;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out);
  }

  .room-eggs .egg .hotspot-label {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: 4px 8px;
    color: var(--text-dark);
    background: var(--accent);
    border: 1px solid var(--border-dark);
    opacity: 0;
    transform: translateX(-50%) translateY(4px);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .room-eggs .egg:hover .hotspot-marker,
  .room-eggs .egg:focus-visible .hotspot-marker {
    animation-play-state: paused;
    opacity: 1;
    transform: scale(1.15);
    filter: drop-shadow(0 0 6px rgb(255 209 102 / 0.8));
  }

  .room-eggs .egg:hover .hotspot-label,
  .room-eggs .egg:focus-visible .hotspot-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .marker-prop {
    width: auto;
    height: 20px;
  }

  .cat-bubble {
    transform: translate(-50%, -160%) scale(0.9);
    padding: 4px 10px;
    font-family: var(--mono-font);
    font-size: 0.72rem;
    font-weight: bold;
    color: var(--text-dark);
    background: var(--window);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .cat-bubble.show {
    opacity: 1;
    transform: translate(-50%, -160%) scale(1);
  }

  @media (hover: none) {
    .room-eggs .egg:active .hotspot-label {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .room-scene.cover {
    margin: 0;
    padding: 0;
    max-width: none;
    width: 100%;
    background: none;
    border: none;
    box-shadow: none;
    animation: none;
  }

  .room-scene.cover .room-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
  }

  .room-scene.cover .room-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    aspect-ratio: auto;
  }

  .room-scene.cover .room-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
  }

  /*
   * The cover-mode image is object-fit:cover against the viewport, so % of the
   * overlay box ≠ % of the image once cropping kicks in. Re-map pin coords:
   *  - viewport wider than 4:3 → image is width-fit, cropped top/bottom.
   *    renderedH = 100vw * 768/1024 = 75vw; crop = (75vw - 100vh) / 2.
   *    pinTop = hy% * 75vw - crop = 75vw * (hy/100 - 0.5) + 50vh.
   *  - viewport taller than 4:3 → mirrored on the x axis with 133.333vh.
   */
  @media (min-width: 641px) and (min-height: 541px) and (min-aspect-ratio: 4/3) {
    .room-scene.cover .pin {
      top: calc(75vw * (var(--hy) / 100 - 0.5) + 50vh);
    }
  }

  @media (min-width: 641px) and (min-height: 541px) and (max-aspect-ratio: 4/3) {
    .room-scene.cover .pin {
      left: calc(133.333vh * (var(--hx) / 100 - 0.5) + 50vw);
    }
  }

  @media (max-width: 640px), (orientation: landscape) and (max-height: 540px) {
    .room-scene.cover .room-overlay {
      position: static;
      display: flex;
      flex-direction: column;
    }

    .room-hotspots {
      position: static;
      margin-top: var(--space-2);
      padding: 0 var(--space-2);
    }

    .room-hotspots ul,
    .room-eggs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      height: auto;
    }

    .room-eggs {
      position: static;
      margin-top: var(--space-2);
      padding: 0 var(--space-2);
    }

    .room-hotspots li,
    .room-eggs .egg {
      order: var(--o);
    }

    .hotspot,
    .room-eggs .egg {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      width: auto;
      height: auto;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      min-height: 44px;
      color: var(--text-dark);
      background: var(--window);
      border: 1px solid var(--border-dark);
      box-shadow: var(--shadow-raised);
      cursor: pointer;
    }

    .hotspot:active,
    .room-eggs .egg:active {
      box-shadow: var(--shadow-sunken);
    }

    .hotspot-marker,
    .room-eggs .egg .hotspot-marker {
      width: 20px;
      height: 20px;
      opacity: 1;
      animation: none;
    }

    .room-eggs .egg .hotspot-label {
      position: static;
      padding: 0;
      color: inherit;
      background: none;
      border: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .cat-bubble {
      position: fixed;
      top: auto;
      bottom: calc(64px + var(--space-3));
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
    }

    .cat-bubble.show {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  import { playCue } from "@/utils/audio";
  import { getVisited, type QuestSection } from "@/utils/progress";
  import { storage, STORAGE_KEYS } from "@/utils/storage";

  const visited = new Set<QuestSection>(getVisited());
  document
    .querySelectorAll<HTMLElement>(".room-hotspots .hotspot[data-section]")
    .forEach((el) => {
      const id = el.getAttribute("data-section") as QuestSection | null;
      if (id && visited.has(id)) el.setAttribute("data-visited", "true");
    });

  const catBtn = document.getElementById("egg-cat");
  const catBubble = document.getElementById("cat-bubble");
  const catLive = document.getElementById("cat-live");
  const floppyBtn = document.getElementById("egg-floppy");
  const readmeDialog = document.getElementById("readme-dialog");

  const catLines = [
    "mrrp~",
    "purr…",
    "zzZzz",
    "…the cat pretends to sleep",
    "*tail flick*",
    "mew!",
  ];
  let catIndex = 0;
  let bubbleTimer: number | undefined;

  catBtn?.addEventListener("click", () => {
    storage.set(STORAGE_KEYS.eggsFound, "1");
    const line = catLines[catIndex++ % catLines.length];
    if (catBubble) {
      catBubble.textContent = line;
      catBubble.classList.add("show");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(
        () => catBubble.classList.remove("show"),
        2400,
      );
    }
    if (catLive) catLive.textContent = `Cat: ${line}`;
  });

  if (readmeDialog instanceof HTMLDialogElement) {
    floppyBtn?.addEventListener("click", () => {
      storage.set(STORAGE_KEYS.eggsFound, "1");
      playCue("open");
      readmeDialog.showModal();
    });
    readmeDialog.addEventListener("click", (event) => {
      if (event.target === readmeDialog) readmeDialog.close();
    });
  }
</script>
