---
import { hotspots } from "@/data/hotspots";

interface Props {
  class?: string;
  cover?: boolean;
}

const { class: className, cover = false } = Astro.props;
const extraHotspots = hotspots.filter((h) => h.optional);
---

<figure class:list={["room-scene", className, cover && "cover"]}>
  <div class="room-bg">
    <img
      src="/assets/backgrounds/bedroom-full.jpg"
      alt="Pixel-art bedroom at night: a bed with a sleeping cat, a wooden desk holding a CRT monitor showing a retro desktop, a keyboard, mug and notebook, a bookshelf, posters on the wall, and a window overlooking a city skyline."
      width="1448"
      height="1086"
      fetchpriority="high"
    />
  </div>
  <div class="room-overlay">
    <div class="room-fx" aria-hidden="true">
      <div class="fx fx-crt" style="--fx:37.8;--fy:29.5;--fw:27.1;--fh:28.4">
        <i class="fx-cloud c1" style="--cy:9;--px:0.8;--ct:58s;--cd:14s"></i>
        <i class="fx-cloud c2" style="--cy:24;--px:0.6;--ct:76s;--cd:47s"></i>
        <i class="fx-cloud c3" style="--cy:38;--px:0.45;--ct:96s;--cd:70s"></i>
      </div>
      <div class="fx fx-lamp" style="--fx:14.5;--fy:31.5;--fw:21;--fh:23"></div>
      <span class="fxp fx-zzz" style="--fx:10.5;--fy:58">
        <i style="--i:0">z</i><i style="--i:1">z</i><i style="--i:2">Z</i>
      </span>
      <i class="fxp fx-star" style="--fx:92.6;--fy:11.5;--d:0s;--t:3.4s"></i>
      <i class="fxp fx-star" style="--fx:95.9;--fy:18.5;--d:1.2s;--t:4.1s"></i>
      <i class="fxp fx-star" style="--fx:91.8;--fy:27;--d:2.1s;--t:3s"></i>
      <i class="fxp fx-star" style="--fx:97.4;--fy:30.5;--d:0.7s;--t:4.6s"></i>
      <i class="fxp fx-star" style="--fx:30.5;--fy:26;--d:1.8s;--t:3.8s"></i>
      <i class="fxp fx-star" style="--fx:35.2;--fy:28.5;--d:2.9s;--t:4.4s"></i>
    </div>
    <time
      class="fx room-clock"
      id="room-clock"
      style="--fx:73.1;--fy:33.1;--fw:15.5;--fh:7.5"
    >
      <span class="room-clock-date" id="room-clock-date"></span>
      <span class="room-clock-time">
        <span id="room-clock-h">--</span><span class="room-clock-colon">:</span><span id="room-clock-m">--</span>
      </span>
    </time>
    <nav class="room-hotspots" aria-label="Room extras">
      <ul>
        {
          extraHotspots.map((h) => (
            <li
              style={`--hx:${h.desktop.x};--hy:${h.desktop.y};--o:${h.mobileOrder}`}
            >
              <a href={h.href} class="hotspot pin" data-section={h.id}>
                <img
                  class="hotspot-marker marker-prop"
                  src={h.icon ?? "/assets/icons/system/hotspot.png"}
                  alt=""
                  width="240"
                  height="156"
                  aria-hidden="true"
                />
                <span class="hotspot-label">{h.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="room-eggs">
      <button
        type="button"
        class="hotspot pin egg"
        id="egg-cat"
        style="--hx:7;--hy:62;--o:7"
        aria-label="Pet the cat"
      >
        <span class="hotspot-marker hotspot-dot" aria-hidden="true"></span>
        <span class="hotspot-label">Pet the cat</span>
      </button>

      <span
        class="cat-bubble pin"
        id="cat-bubble"
        style="--hx:11;--hy:53"
        aria-hidden="true"
      ></span>
    </div>
    <slot name="overlay" />
  </div>
  <figcaption class="room-hint sr-only">
    Use the navigation to explore, or try the room extras.
  </figcaption>
</figure>
<p class="sr-only" id="cat-live" aria-live="polite"></p>



<style>
  .room-scene {
    position: relative;
    margin: var(--space-6) auto 0;
    max-width: min(100%, calc((100vh - 14rem) * 1024 / 630));
    max-width: min(100%, calc((100dvh - 14rem) * 1024 / 630));
    padding: var(--space-2);
    background: var(--surface);
    border: 2px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    animation: room-in 0.55s var(--ease-out) both;
  }

  @keyframes room-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .room-hint {
    padding: var(--space-2) var(--space-1) 0;
    font-family: var(--mono-font);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.85;
  }

  .room-hint b {
    color: var(--accent);
  }

  .room-bg {
    position: relative;
  }

  .room-bg img {
    width: 100%;
    aspect-ratio: 1024 / 768;
    object-fit: contain;
    image-rendering: pixelated;
    background: var(--bg-deep);
    display: block;
  }

  @keyframes room-ambient-light {
    0%, 100% { filter: brightness(1) saturate(1); }
    50% { filter: brightness(1.035) saturate(1.04); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .room-scene.cover .room-bg img {
      animation: room-ambient-light 12s ease-in-out infinite;
    }
  }

  :global(html[data-reduced-effects="true"]) .room-scene.cover .room-bg img {
    animation: none;
  }

  .room-overlay {
    position: absolute;
    inset: 0;
  }

  .room-hotspots {
    position: absolute;
    inset: 0;
  }

  .room-hotspots ul {
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pin {
    position: absolute;
    left: calc(var(--hx) * 1%);
    top: calc(var(--hy) * 1%);
  }

  .hotspot {
    position: absolute;
    display: grid;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    padding: 0;
    color: var(--text-dark);
    background: transparent;
    border: 0;
    box-shadow: none;
    text-decoration: none;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .hotspot-marker {
    position: relative;
    z-index: 1;
    flex: none;
    width: 24px;
    height: 24px;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(0 1px 2px rgb(15 23 42 / 0.8));
    transition:
      transform var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out);
  }

  .room-hotspots .hotspot-label {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: calc(100% + 5px);
    padding: 3px var(--space-2);
    font-family: var(--mono-font);
    font-size: 0.64rem;
    font-weight: bold;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #f4edd5;
    background: transparent;
    border: 0;
    box-shadow: none;
    text-shadow: 1px 1px 0 #101a31, -1px -1px 0 #101a31;
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .room-hotspots .hotspot:focus-visible,
  .room-eggs .egg:focus-visible {
    outline: none;
  }

  .room-hotspots .hotspot:hover .hotspot-marker,
  .room-hotspots .hotspot:focus-visible .hotspot-marker {
    transform: scale(1.14);
    filter: drop-shadow(0 0 5px rgb(255 209 102 / 0.9));
  }

  .room-hotspots .hotspot:hover .hotspot-label,
  .room-hotspots .hotspot:focus-visible .hotspot-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .room-eggs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .room-eggs .egg {
    pointer-events: auto;
    justify-content: center;
    gap: 0;
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    color: var(--text);
    background: none;
    border: none;
    box-shadow: none;
    font: inherit;
    cursor: pointer;
  }

  .room-eggs .egg .hotspot-marker {
    width: 28px;
    height: 28px;
    opacity: 0.55;
    animation: marker-glow 2.6s ease-in-out infinite;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out);
  }

  .room-eggs .egg .hotspot-label {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: 4px 8px;
    color: #f4edd5;
    background: transparent;
    border: 0;
    box-shadow: none;
    text-shadow: 1px 1px 0 #101a31, -1px -1px 0 #101a31;
    opacity: 1;
    transform: translateX(-50%);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .room-eggs .egg:hover .hotspot-marker,
  .room-eggs .egg:focus-visible .hotspot-marker {
    animation-play-state: paused;
    opacity: 1;
    transform: scale(1.15);
    filter: drop-shadow(0 0 6px rgb(255 209 102 / 0.8));
  }

  .room-eggs .egg:hover .hotspot-label,
  .room-eggs .egg:focus-visible .hotspot-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .room-eggs .hotspot-dot {
    width: 14px;
    height: 14px;
    background: rgb(255 209 102 / 0.26);
    border: 2px solid var(--accent);
    box-shadow: 0 0 8px rgb(255 209 102 / 0.62);
  }

  #egg-cat .hotspot-label {
    left: 0;
    transform: translateY(4px);
  }

  #egg-cat:hover .hotspot-label,
  #egg-cat:focus-visible .hotspot-label {
    transform: translateY(0);
  }


  .marker-prop {
    width: auto;
    height: 20px;
  }

  .cat-bubble {
    transform: translate(-50%, -160%) scale(0.9);
    padding: 4px 10px;
    font-family: var(--mono-font);
    font-size: 0.72rem;
    font-weight: bold;
    color: var(--text-dark);
    background: var(--window);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .cat-bubble.show {
    opacity: 1;
    transform: translate(-50%, -160%) scale(1);
  }

  @media (hover: none) {
    .room-eggs .egg:active .hotspot-label {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .room-scene.cover {
    margin: 0;
    padding: 0;
    max-width: none;
    width: 100%;
    background: none;
    border: none;
    box-shadow: none;
    animation: none;
  }

  .room-scene.cover .room-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
  }

  .room-scene.cover .room-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    aspect-ratio: auto;
  }

  .room-scene.cover .room-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
  }

  /*
   * The cover-mode image is object-fit:cover against the viewport, so % of the
   * overlay box ≠ % of the image once cropping kicks in. Re-map pin coords:
   *  - viewport wider than 4:3 → image is width-fit, cropped top/bottom.
   *    renderedH = 100vw * 768/1024 = 75vw; crop = (75vw - 100vh) / 2.
   *    pinTop = hy% * 75vw - crop = 75vw * (hy/100 - 0.5) + 50vh.
   *  - viewport taller than 4:3 → mirrored on the x axis with 133.333vh.
   */
  @media (min-width: 641px) and (min-height: 541px) and (min-aspect-ratio: 4/3) {
    .room-scene.cover .pin {
      top: calc(75vw * (var(--hy) / 100 - 0.5) + 50vh);
    }
  }

  @media (min-width: 641px) and (min-height: 541px) and (max-aspect-ratio: 4/3) {
    .room-scene.cover .pin {
      left: calc(133.333vh * (var(--hx) / 100 - 0.5) + 50vw);
    }
  }

  @media (max-width: 640px), (orientation: landscape) and (max-height: 540px) {
    .room-scene.cover .room-overlay {
      position: static;
      display: flex;
      flex-direction: column;
    }

    .room-hotspots {
      position: static;
      margin-top: var(--space-2);
      padding: 0 var(--space-2);
    }

    .room-hotspots ul,
    .room-eggs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      height: auto;
    }

    .room-eggs {
      position: static;
      margin-top: var(--space-2);
      padding: 0 var(--space-2);
    }

    .room-hotspots li,
    .room-eggs .egg {
      order: var(--o);
    }

    .hotspot,
    .room-eggs .egg {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      width: auto;
      height: auto;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      min-height: 44px;
      color: var(--text-dark);
      background: var(--window);
      border: 1px solid var(--border-dark);
      box-shadow: var(--shadow-raised);
      cursor: pointer;
    }

    .hotspot:active,
    .room-eggs .egg:active {
      box-shadow: var(--shadow-sunken);
    }

    .room-hotspots .hotspot-label {
      position: static;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .hotspot-marker,
    .room-eggs .egg .hotspot-marker {
      width: 20px;
      height: 20px;
      opacity: 1;
      animation: none;
    }

    .room-eggs .egg .hotspot-label {
      position: static;
      padding: 0;
      color: inherit;
      background: none;
      border: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .cat-bubble {
      position: fixed;
      top: auto;
      bottom: calc(64px + var(--space-3));
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
    }

    .cat-bubble.show {
      transform: translateX(-50%);
    }
  }

  /* Ambient scene overlays (coordinates are % of the 4:3 room image) */
  .room-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    container-type: size;
  }

  .fx {
    position: absolute;
    left: calc(var(--fx) * 1%);
    top: calc(var(--fy) * 1%);
    width: calc(var(--fw, 0) * 1%);
    height: calc(var(--fh, 0) * 1%);
  }

  .fxp {
    position: absolute;
    left: calc(var(--fx) * 1%);
    top: calc(var(--fy) * 1%);
    transform: translate(-50%, -50%);
  }

  /* Live LED clock, patched over the shelf clock display */
  .room-clock {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5cqh;
    padding: 0 3cqw;
    font-family: var(--mono-font);
    line-height: 1;
    color: #43e88a;
    text-shadow: 0 0 0.6cqh rgb(67 232 138 / 0.55);
    background: linear-gradient(180deg, #0c1a12, #08110b 58%, #0a1610);
    border-radius: 6%;
    box-shadow: inset 0 0 1.4cqh rgb(0 0 0 / 0.8);
    container-type: size;
    pointer-events: none;
    user-select: none;
  }

  .room-clock-date {
    font-size: 19cqh;
    letter-spacing: 0.14em;
    white-space: nowrap;
    opacity: 0.92;
  }

  .room-clock-time {
    font-size: 46cqh;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  @keyframes clock-colon-blink {
    0%, 49.9% { opacity: 1; }
    50%, 100% { opacity: 0.18; }
  }

  /* CRT screen: static scanlines + vignette, plus flicker and a light sweep */
  .fx-crt {
    overflow: hidden;
    border-radius: 4% / 6%;
    background: rgb(140 180 255 / 0.04);
    box-shadow: inset 0 0 8cqh rgb(8 12 30 / 0.5);
  }

  .fx-crt::before {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgb(5 10 28 / 0.22) 0 1px,
      transparent 1px 4px
    );
  }

  .fx-crt::after {
    content: "";
    position: absolute;
    z-index: 3;
    top: -15%;
    bottom: -15%;
    left: -45%;
    width: 36%;
    background: linear-gradient(
      100deg,
      transparent,
      rgb(200 225 255 / 0.09) 50%,
      transparent
    );
    transform: skewX(-12deg);
  }

  /* Pixel clouds drifting across the screen sky (1em = 1 pixel block) */
  .fx-cloud {
    position: absolute;
    top: calc(var(--cy) * 1%);
    left: -20%;
    width: 1em;
    height: 1em;
    font-size: calc(var(--px, 0.7) * 1cqh);
    background: transparent;
    opacity: 0.9;
  }

  .fx-cloud.c1 {
    box-shadow:
      4em 0 0 0 #f6fbff, 5em 0 0 0 #f6fbff, 6em 0 0 0 #f6fbff, 7em 0 0 0 #f6fbff,
      2em 1em 0 0 #f6fbff, 3em 1em 0 0 #f6fbff, 4em 1em 0 0 #f6fbff,
      5em 1em 0 0 #f6fbff, 6em 1em 0 0 #f6fbff, 7em 1em 0 0 #f6fbff, 8em 1em 0 0 #f6fbff,
      1em 2em 0 0 #f6fbff, 2em 2em 0 0 #f6fbff, 3em 2em 0 0 #f6fbff,
      4em 2em 0 0 #f6fbff, 5em 2em 0 0 #f6fbff, 6em 2em 0 0 #f6fbff,
      7em 2em 0 0 #f6fbff, 8em 2em 0 0 #f6fbff, 9em 2em 0 0 #f6fbff,
      0 3em 0 0 #f6fbff, 1em 3em 0 0 #f6fbff, 2em 3em 0 0 #f6fbff,
      3em 3em 0 0 #f6fbff, 4em 3em 0 0 #f6fbff, 5em 3em 0 0 #f6fbff,
      6em 3em 0 0 #f6fbff, 7em 3em 0 0 #f6fbff, 8em 3em 0 0 #f6fbff,
      9em 3em 0 0 #f6fbff, 10em 3em 0 0 #f6fbff,
      2em 4em 0 0 #cfe2f7, 3em 4em 0 0 #cfe2f7, 4em 4em 0 0 #cfe2f7,
      5em 4em 0 0 #cfe2f7, 6em 4em 0 0 #cfe2f7, 7em 4em 0 0 #cfe2f7, 8em 4em 0 0 #cfe2f7;
  }

  .fx-cloud.c2 {
    box-shadow:
      3em 0 0 0 #f6fbff, 4em 0 0 0 #f6fbff, 5em 0 0 0 #f6fbff,
      2em 1em 0 0 #f6fbff, 3em 1em 0 0 #f6fbff, 4em 1em 0 0 #f6fbff,
      5em 1em 0 0 #f6fbff, 6em 1em 0 0 #f6fbff,
      0 2em 0 0 #f6fbff, 1em 2em 0 0 #f6fbff, 2em 2em 0 0 #f6fbff,
      3em 2em 0 0 #f6fbff, 4em 2em 0 0 #f6fbff, 5em 2em 0 0 #f6fbff,
      6em 2em 0 0 #f6fbff, 7em 2em 0 0 #f6fbff,
      1em 3em 0 0 #cfe2f7, 2em 3em 0 0 #cfe2f7, 3em 3em 0 0 #cfe2f7,
      4em 3em 0 0 #cfe2f7, 5em 3em 0 0 #cfe2f7, 6em 3em 0 0 #cfe2f7;
  }

  .fx-cloud.c3 {
    box-shadow:
      1em 0 0 0 #f6fbff, 2em 0 0 0 #f6fbff, 3em 0 0 0 #f6fbff, 4em 0 0 0 #f6fbff,
      0 1em 0 0 #f6fbff, 1em 1em 0 0 #f6fbff, 2em 1em 0 0 #f6fbff,
      3em 1em 0 0 #f6fbff, 4em 1em 0 0 #f6fbff, 5em 1em 0 0 #f6fbff,
      1em 2em 0 0 #cfe2f7, 2em 2em 0 0 #cfe2f7, 3em 2em 0 0 #cfe2f7, 4em 2em 0 0 #cfe2f7;
  }

  @keyframes cloud-drift {
    from { left: -20%; }
    to { left: 115%; }
  }

  @keyframes crt-flicker {
    0%, 100% { opacity: 1; }
    18% { opacity: 0.82; }
    24% { opacity: 0.95; }
    47% { opacity: 0.76; }
    52% { opacity: 1; }
    76% { opacity: 0.88; }
    84% { opacity: 0.99; }
  }

  @keyframes crt-sweep {
    0%, 60% { left: -45%; }
    82%, 100% { left: 115%; }
  }

  /* Desk lamp warm glow */
  .fx-lamp {
    background: radial-gradient(
      ellipse 52% 54% at 46% 40%,
      rgb(255 195 105 / 0.3),
      rgb(255 165 75 / 0.12) 55%,
      transparent 78%
    );
    mix-blend-mode: screen;
  }

  @keyframes lamp-glow {
    0%, 100% { opacity: 0.8; }
    45% { opacity: 1; }
    58% { opacity: 0.88; }
    72% { opacity: 0.96; }
  }

  /* Sleeping cat: drifting Zzz */
  .fx-zzz i {
    position: absolute;
    left: 0;
    bottom: 0;
    font-family: var(--mono-font);
    font-style: normal;
    font-weight: 700;
    font-size: calc(0.9cqh + var(--i) * 0.4cqh);
    color: #dfe8ff;
    text-shadow: 1px 1px 0 #101a31;
    opacity: 0;
  }

  @keyframes zzz-drift {
    0% {
      opacity: 0;
      transform: translate(0, 0.4cqh) scale(0.8);
    }
    18% { opacity: 0.95; }
    70% { opacity: 0.7; }
    100% {
      opacity: 0;
      transform: translate(
        calc(0.9cqh + var(--i) * 0.3cqh),
        -3.6cqh
      ) scale(1.12);
    }
  }

  /* Twinkling lights: window sky + poster skyline */
  .fx-star {
    width: 0.45cqh;
    height: 0.45cqh;
    border-radius: 50%;
    background: #eaf4ff;
    box-shadow: 0 0 0.7cqh 0.12cqh rgb(190 225 255 / 0.75);
    opacity: 0.2;
  }

  @keyframes star-twinkle {
    0%, 100% {
      opacity: 0.1;
      transform: translate(-50%, -50%) scale(0.7);
    }
    50% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .room-clock-colon {
      animation: clock-colon-blink 2s steps(1) infinite;
    }
    .fx-crt {
      animation: crt-flicker 4.5s steps(5) infinite;
    }
    .fx-crt::after {
      animation: crt-sweep 11s ease-in-out infinite;
    }
    .fx-cloud {
      animation: cloud-drift var(--ct, 70s) linear infinite;
      animation-delay: calc(var(--cd, 0s) * -1);
    }
    .fx-lamp {
      animation: lamp-glow 4.8s ease-in-out infinite;
    }
    .fx-zzz i {
      animation: zzz-drift 3.9s ease-out infinite;
      animation-delay: calc(var(--i) * 1.3s);
    }
    .fx-star {
      animation: star-twinkle var(--t, 3s) ease-in-out infinite;
      animation-delay: var(--d, 0s);
    }
  }

  /* Cover mode: image is object-fit:cover — remap fx like .pin, incl. box sizes */
  @media (min-width: 641px) and (min-height: 541px) and (min-aspect-ratio: 4/3) {
    .room-scene.cover .fx,
    .room-scene.cover .fxp {
      top: calc(75vw * (var(--fy) / 100 - 0.5) + 50vh);
    }
    .room-scene.cover .fx {
      height: calc(var(--fh, 0) * 0.75vw);
    }
  }

  @media (min-width: 641px) and (min-height: 541px) and (max-aspect-ratio: 4/3) {
    .room-scene.cover .fx,
    .room-scene.cover .fxp {
      left: calc(133.333vh * (var(--fx) / 100 - 0.5) + 50vw);
    }
    .room-scene.cover .fx {
      width: calc(var(--fw, 0) * 1.33333vh);
    }
  }

  /* Compact layout: hide positioned decor, keep the clock as a chip */
  @media (max-width: 640px), (orientation: landscape) and (max-height: 540px) {
    .room-scene.cover .room-fx {
      display: none;
    }

    .room-scene.cover .room-clock {
      position: static;
      order: -1;
      width: 10.5rem;
      height: 2.7rem;
      margin: var(--space-2) var(--space-2) 0;
      align-self: flex-start;
    }
  }
</style>

<script>
  import { storage, STORAGE_KEYS } from "@/utils/storage";

  const catBtn = document.getElementById("egg-cat");
  const catBubble = document.getElementById("cat-bubble");
  const catLive = document.getElementById("cat-live");

  const catLines = [
    "mrrp~",
    "purr…",
    "zzZzz",
    "…the cat pretends to sleep",
    "*tail flick*",
    "mew!",
  ];
  let catIndex = 0;
  let bubbleTimer: number | undefined;

  catBtn?.addEventListener("click", () => {
    storage.set(STORAGE_KEYS.eggsFound, "1");
    const line = catLines[catIndex++ % catLines.length];
    if (catBubble) {
      catBubble.textContent = line;
      catBubble.classList.add("show");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(
        () => catBubble.classList.remove("show"),
        2400,
      );
    }
    if (catLive) catLive.textContent = `Cat: ${line}`;
  });

  const roomClock = document.getElementById("room-clock");
  const rcDate = document.getElementById("room-clock-date");
  const rcH = document.getElementById("room-clock-h");
  const rcM = document.getElementById("room-clock-m");

  if (roomClock && rcDate && rcH && rcM) {
    const DAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];
    const MONTHS = [
      "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
      "JUL", "AUG", "SEP", "OCT", "NOV", "DEC",
    ];
    const renderClock = () => {
      const now = new Date();
      const h24 = now.getHours();
      rcDate.textContent =
        `${DAYS[now.getDay()]}, ${MONTHS[now.getMonth()]} ` +
        `${String(now.getDate()).padStart(2, "0")} ${now.getFullYear()}`;
      rcH.textContent = String(h24).padStart(2, "0");
      rcM.textContent = String(now.getMinutes()).padStart(2, "0");
      roomClock.setAttribute("datetime", now.toISOString());
    };
    renderClock();
    window.setInterval(renderClock, 1000);
  }

</script>
