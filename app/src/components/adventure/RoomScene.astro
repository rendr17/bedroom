---
import { hotspots } from "@/data/hotspots";

interface Props {
  class?: string;
  cover?: boolean;
}

const { class: className, cover = false } = Astro.props;
const extraHotspots = hotspots.filter((h) => h.optional);
---

<figure class:list={["room-scene", className, cover && "cover"]}>
  <div class="room-bg">
    <img
      src="/assets/backgrounds/bedroom-full.jpg"
      alt="Pixel-art bedroom at night: a bed with a sleeping cat, a wooden desk holding a CRT monitor showing a retro desktop, a keyboard, mug and notebook, a bookshelf, posters on the wall, and a window overlooking a city skyline."
      width="1448"
      height="1086"
      fetchpriority="high"
    />
  </div>
  <div class="room-overlay">
    <nav class="room-hotspots" aria-label="Room extras">
      <ul>
        {
          extraHotspots.map((h) => (
            <li
              style={`--hx:${h.desktop.x};--hy:${h.desktop.y};--o:${h.mobileOrder}`}
            >
              <a href={h.href} class="hotspot pin" data-section={h.id}>
                <img
                  class="hotspot-marker marker-prop"
                  src={h.icon ?? "/assets/icons/system/hotspot.png"}
                  alt=""
                  width="240"
                  height="156"
                  aria-hidden="true"
                />
                <span class="hotspot-label">{h.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="room-eggs">
      <button
        type="button"
        class="hotspot pin egg"
        id="egg-cat"
        style="--hx:7;--hy:62;--o:7"
        aria-label="Pet the cat"
      >
        <span class="hotspot-marker hotspot-dot" aria-hidden="true"></span>
        <span class="hotspot-label">Pet the cat</span>
      </button>

      <span
        class="cat-bubble pin"
        id="cat-bubble"
        style="--hx:11;--hy:53"
        aria-hidden="true"
      ></span>
    </div>
    <slot name="overlay" />
  </div>
  <figcaption class="room-hint sr-only">
    Use the navigation to explore, or try the room extras.
  </figcaption>
</figure>
<p class="sr-only" id="cat-live" aria-live="polite"></p>



<style>
  .room-scene {
    position: relative;
    margin: var(--space-6) auto 0;
    max-width: min(100%, calc((100vh - 14rem) * 1024 / 630));
    max-width: min(100%, calc((100dvh - 14rem) * 1024 / 630));
    padding: var(--space-2);
    background: var(--surface);
    border: 2px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    animation: room-in 0.55s var(--ease-out) both;
  }

  @keyframes room-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .room-hint {
    padding: var(--space-2) var(--space-1) 0;
    font-family: var(--mono-font);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.85;
  }

  .room-hint b {
    color: var(--accent);
  }

  .room-bg {
    position: relative;
  }

  .room-bg img {
    width: 100%;
    aspect-ratio: 1024 / 768;
    object-fit: contain;
    image-rendering: pixelated;
    background: var(--bg-deep);
    display: block;
  }

  @keyframes room-ambient-light {
    0%, 100% { filter: brightness(1) saturate(1); }
    50% { filter: brightness(1.035) saturate(1.04); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .room-scene.cover .room-bg img {
      animation: room-ambient-light 12s ease-in-out infinite;
    }
  }

  :global(html[data-reduced-effects="true"]) .room-scene.cover .room-bg img {
    animation: none;
  }

  .room-overlay {
    position: absolute;
    inset: 0;
  }

  .room-hotspots {
    position: absolute;
    inset: 0;
  }

  .room-hotspots ul {
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pin {
    position: absolute;
    left: calc(var(--hx) * 1%);
    top: calc(var(--hy) * 1%);
  }

  .hotspot {
    position: absolute;
    display: grid;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    padding: 0;
    color: var(--text-dark);
    background: transparent;
    border: 0;
    box-shadow: none;
    text-decoration: none;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .hotspot-marker {
    position: relative;
    z-index: 1;
    flex: none;
    width: 24px;
    height: 24px;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(0 1px 2px rgb(15 23 42 / 0.8));
    transition:
      transform var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out);
  }

  .room-hotspots .hotspot-label {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: calc(100% + 5px);
    padding: 3px var(--space-2);
    font-family: var(--mono-font);
    font-size: 0.64rem;
    font-weight: bold;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #f4edd5;
    background: transparent;
    border: 0;
    box-shadow: none;
    text-shadow: 1px 1px 0 #101a31, -1px -1px 0 #101a31;
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .room-hotspots .hotspot:focus-visible,
  .room-eggs .egg:focus-visible {
    outline: none;
  }

  .room-hotspots .hotspot:hover .hotspot-marker,
  .room-hotspots .hotspot:focus-visible .hotspot-marker {
    transform: scale(1.14);
    filter: drop-shadow(0 0 5px rgb(255 209 102 / 0.9));
  }

  .room-hotspots .hotspot:hover .hotspot-label,
  .room-hotspots .hotspot:focus-visible .hotspot-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .room-eggs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .room-eggs .egg {
    pointer-events: auto;
    justify-content: center;
    gap: 0;
    width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0;
    color: var(--text);
    background: none;
    border: none;
    box-shadow: none;
    font: inherit;
    cursor: pointer;
  }

  .room-eggs .egg .hotspot-marker {
    width: 28px;
    height: 28px;
    opacity: 0.55;
    animation: marker-glow 2.6s ease-in-out infinite;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      filter var(--duration-fast) var(--ease-out);
  }

  .room-eggs .egg .hotspot-label {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: 4px 8px;
    color: #f4edd5;
    background: transparent;
    border: 0;
    box-shadow: none;
    text-shadow: 1px 1px 0 #101a31, -1px -1px 0 #101a31;
    opacity: 1;
    transform: translateX(-50%);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .room-eggs .egg:hover .hotspot-marker,
  .room-eggs .egg:focus-visible .hotspot-marker {
    animation-play-state: paused;
    opacity: 1;
    transform: scale(1.15);
    filter: drop-shadow(0 0 6px rgb(255 209 102 / 0.8));
  }

  .room-eggs .egg:hover .hotspot-label,
  .room-eggs .egg:focus-visible .hotspot-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .room-eggs .hotspot-dot {
    width: 14px;
    height: 14px;
    background: rgb(255 209 102 / 0.26);
    border: 2px solid var(--accent);
    box-shadow: 0 0 8px rgb(255 209 102 / 0.62);
  }

  #egg-cat .hotspot-label {
    left: 0;
    transform: translateY(4px);
  }

  #egg-cat:hover .hotspot-label,
  #egg-cat:focus-visible .hotspot-label {
    transform: translateY(0);
  }


  .marker-prop {
    width: auto;
    height: 20px;
  }

  .cat-bubble {
    transform: translate(-50%, -160%) scale(0.9);
    padding: 4px 10px;
    font-family: var(--mono-font);
    font-size: 0.72rem;
    font-weight: bold;
    color: var(--text-dark);
    background: var(--window);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .cat-bubble.show {
    opacity: 1;
    transform: translate(-50%, -160%) scale(1);
  }

  @media (hover: none) {
    .room-eggs .egg:active .hotspot-label {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .room-scene.cover {
    margin: 0;
    padding: 0;
    max-width: none;
    width: 100%;
    background: none;
    border: none;
    box-shadow: none;
    animation: none;
  }

  .room-scene.cover .room-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
  }

  .room-scene.cover .room-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    aspect-ratio: auto;
  }

  .room-scene.cover .room-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
  }

  /*
   * The cover-mode image is object-fit:cover against the viewport, so % of the
   * overlay box ≠ % of the image once cropping kicks in. Re-map pin coords:
   *  - viewport wider than 4:3 → image is width-fit, cropped top/bottom.
   *    renderedH = 100vw * 768/1024 = 75vw; crop = (75vw - 100vh) / 2.
   *    pinTop = hy% * 75vw - crop = 75vw * (hy/100 - 0.5) + 50vh.
   *  - viewport taller than 4:3 → mirrored on the x axis with 133.333vh.
   */
  @media (min-width: 641px) and (min-height: 541px) and (min-aspect-ratio: 4/3) {
    .room-scene.cover .pin {
      top: calc(75vw * (var(--hy) / 100 - 0.5) + 50vh);
    }
  }

  @media (min-width: 641px) and (min-height: 541px) and (max-aspect-ratio: 4/3) {
    .room-scene.cover .pin {
      left: calc(133.333vh * (var(--hx) / 100 - 0.5) + 50vw);
    }
  }

  @media (max-width: 640px), (orientation: landscape) and (max-height: 540px) {
    .room-scene.cover .room-overlay {
      position: static;
      display: flex;
      flex-direction: column;
    }

    .room-hotspots {
      position: static;
      margin-top: var(--space-2);
      padding: 0 var(--space-2);
    }

    .room-hotspots ul,
    .room-eggs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      height: auto;
    }

    .room-eggs {
      position: static;
      margin-top: var(--space-2);
      padding: 0 var(--space-2);
    }

    .room-hotspots li,
    .room-eggs .egg {
      order: var(--o);
    }

    .hotspot,
    .room-eggs .egg {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      width: auto;
      height: auto;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      min-height: 44px;
      color: var(--text-dark);
      background: var(--window);
      border: 1px solid var(--border-dark);
      box-shadow: var(--shadow-raised);
      cursor: pointer;
    }

    .hotspot:active,
    .room-eggs .egg:active {
      box-shadow: var(--shadow-sunken);
    }

    .room-hotspots .hotspot-label {
      position: static;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .hotspot-marker,
    .room-eggs .egg .hotspot-marker {
      width: 20px;
      height: 20px;
      opacity: 1;
      animation: none;
    }

    .room-eggs .egg .hotspot-label {
      position: static;
      padding: 0;
      color: inherit;
      background: none;
      border: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .cat-bubble {
      position: fixed;
      top: auto;
      bottom: calc(64px + var(--space-3));
      left: 50%;
      transform: translateX(-50%);
      z-index: 30;
    }

    .cat-bubble.show {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  import { storage, STORAGE_KEYS } from "@/utils/storage";

  const catBtn = document.getElementById("egg-cat");
  const catBubble = document.getElementById("cat-bubble");
  const catLive = document.getElementById("cat-live");

  const catLines = [
    "mrrp~",
    "purr…",
    "zzZzz",
    "…the cat pretends to sleep",
    "*tail flick*",
    "mew!",
  ];
  let catIndex = 0;
  let bubbleTimer: number | undefined;

  catBtn?.addEventListener("click", () => {
    storage.set(STORAGE_KEYS.eggsFound, "1");
    const line = catLines[catIndex++ % catLines.length];
    if (catBubble) {
      catBubble.textContent = line;
      catBubble.classList.add("show");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(
        () => catBubble.classList.remove("show"),
        2400,
      );
    }
    if (catLive) catLive.textContent = `Cat: ${line}`;
  });

</script>
