---
import SceneLayout from "@/layouts/SceneLayout.astro";
import PhotoFrame from "@/components/content/PhotoFrame.astro";
import PixelLabel from "@/components/ui/PixelLabel.astro";
import { profile } from "@/data/profile";
---

<SceneLayout
  title="About"
  windowTitle="ABOUT.EXE"
  description={`About ${profile.name}, a ${profile.role.toLowerCase()} focused on practical web systems, AI integration, and internal tools.`}
>
  <h1 class="about-heading">About {profile.name}</h1>

  <div class="about-hero">
    <div class="about-photo">
      <PhotoFrame
        src="/assets/props/avatar-placeholder.png"
        alt="Pixel-art portrait placeholder of Rendi — messy dark hair, blue hoodie"
        width={325}
        height={388}
        caption="PORTRAIT.BMP"
      />
    </div>
    <section class="notebook-card">
      <PixelLabel tone="ink">README.TXT</PixelLabel>
      <p>
        I'm <strong>{profile.name}</strong>, a {profile.role.toLowerCase()}.
        {profile.bio}
      </p>
      <p>
        Right now: <strong>{profile.now}</strong>.
      </p>
      <p>
        Next: <strong>{profile.next}</strong>.
      </p>
      <p class="about-links">
        <a href="/projects">Projects</a> · <a href="/experience">Experience</a> ·
        <a href="/skills">Skills</a> · <a href="/contact">Contact</a>
      </p>
    </section>
  </div>

  <div class="about-grid">
    <section class="notebook-card">
      <h2>Focus areas</h2>
      <ul>
        {profile.focus.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section class="notebook-card">
      <h2>Things I like building</h2>
      <ul>
        {profile.interests.map((item) => <li>{item}</li>)}
      </ul>
      <img
        class="notebook-prop"
        src="/assets/props/notebook.png"
        alt=""
        width={332}
        height={298}
        loading="lazy"
        aria-hidden="true"
      />
    </section>
  </div>
</SceneLayout>

<style>
  .about-heading {
    margin-bottom: var(--space-4);
    font-family: var(--mono-font);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .about-hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: flex-start;
    margin-bottom: var(--space-4);
  }

  .about-photo {
    flex: 0 1 180px;
    min-width: 140px;
    max-width: 200px;
    transform: rotate(-1.5deg);
    animation: photo-in 0.5s var(--ease-out) both;
  }

  @keyframes photo-in {
    from {
      opacity: 0;
      transform: rotate(-1.5deg) translateY(8px);
    }
    to {
      opacity: 1;
      transform: rotate(-1.5deg) translateY(0);
    }
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--space-4);
  }

  .notebook-card {
    flex: 1 1 300px;
    padding: var(--space-4);
    padding-left: calc(var(--space-6) + var(--space-3));
    color: var(--text-dark);
    background:
      linear-gradient(
        90deg,
        transparent 0 calc(var(--space-6) + 2px),
        rgb(225 83 83 / 0.45) calc(var(--space-6) + 2px)
          calc(var(--space-6) + 3px),
        transparent calc(var(--space-6) + 3px)
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(1.6em - 1px),
        rgb(74 144 226 / 0.2) calc(1.6em - 1px) 1.6em
      ),
      var(--window);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised), var(--shadow-panel);
  }

  .notebook-card > * + * {
    margin-top: var(--space-3);
  }

  .notebook-card h2 {
    color: var(--primary);
  }

  .notebook-card ul {
    padding-left: var(--space-4);
  }

  .notebook-card li + li {
    margin-top: var(--space-2);
  }

  .notebook-card :global(a) {
    color: var(--primary);
  }

  .about-links {
    font-family: var(--mono-font);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .about-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .about-links a:hover,
  .about-links a:focus-visible {
    color: var(--accent);
  }

  .notebook-prop {
    display: block;
    width: 96px;
    height: auto;
    margin-left: auto;
    image-rendering: pixelated;
    transform: rotate(4deg);
  }
</style>
