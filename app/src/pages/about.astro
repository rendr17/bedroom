---
import ContentLayout from "@/layouts/ContentLayout.astro";
import { profile } from "@/data/profile";
---

<ContentLayout
  title="About"
  description={`About ${profile.name}, a ${profile.role.toLowerCase()} focused on practical web systems, AI integration, and internal tools.`}
>
  <p>
    I'm <strong>{profile.name}</strong>, a {profile.role.toLowerCase()}.
    {profile.bio}
  </p>
  <h2>Focus areas</h2>
  <ul>
    {profile.focus.map((item) => <li>{item}</li>)}
  </ul>
  <h2>Things I like building</h2>
  <ul>
    {profile.interests.map((item) => <li>{item}</li>)}
  </ul>
  <p>
    Currently exploring: <strong>{profile.currentFocus}</strong>.
  </p>
</ContentLayout>
