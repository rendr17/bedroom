---
import ContentLayout from "@/layouts/ContentLayout.astro";
import { getSortedProjects } from "@/utils/content";

const projects = await getSortedProjects();
---

<ContentLayout
  title="Projects"
  description="Selected projects by Rendi — case studies covering problem, role, solution, technology, and impact."
>
  <p>
    Selected work — each entry links to a case study covering the problem, my
    role, the solution, and what it changed.
  </p>
  <ul class="project-list">
    {
      projects.map((project) => (
        <li>
          <a href={`/projects/${project.id}`}>{project.data.title}</a>
          <span class="project-meta">
            {project.data.subtitle} · {project.data.status}
          </span>
        </li>
      ))
    }
  </ul>
</ContentLayout>
