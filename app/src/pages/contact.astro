---
import ContentLayout from "@/layouts/ContentLayout.astro";
import { socials } from "@/data/socials";
---

<ContentLayout
  title="Contact"
  description="Get in touch with Rendi — email, GitHub, LinkedIn, and CV."
>
  <p>The quickest ways to reach me:</p>
  <ul>
    {
      socials.map((social) => (
        <li>
          {social.href ? (
            <a href={social.href}>{social.label}</a>
          ) : (
            <>
              {social.label} — <em>to be published</em>
            </>
          )}
        </li>
      ))
    }
  </ul>
  <p>Public contact details will appear here as direct links once confirmed.</p>
</ContentLayout>
