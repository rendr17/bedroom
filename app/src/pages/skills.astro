---
import { getCollection } from "astro:content";
import ContentLayout from "@/layouts/ContentLayout.astro";
import RetroWindow from "@/components/ui/RetroWindow.astro";

const groups = (await getCollection("skills")).filter(
  (group) => group.data.items.length > 0,
);
---

<ContentLayout
  title="Skills"
  description="Rendi's skills grouped by practical capability — frontend, backend, integrations, AI-assisted development, and tooling."
>
  <p>
    Capabilities grouped by practical use — no percentage bars, just what I
    actually work with.
  </p>

  <RetroWindow title="TOOLBOX.EXE" controls={false}>
    <div class="drawer-grid">
      {
        groups.length > 0 ? (
          groups.map((group) => {
            const isFocus = group.id === "ai-assisted";
            return (
              <section
                class:list={["drawer", isFocus && "drawer-focus"]}
                aria-labelledby={`skill-${group.id}`}
              >
                <div class="drawer-heading">
                  {isFocus && <span class="drawer-kicker">Current focus</span>}
                  <h2 class="drawer-label" id={`skill-${group.id}`}>
                    {group.data.name}
                  </h2>
                </div>
                <ul class="tool-list">
                  {group.data.items.map((item) => (
                    <li class="tool">
                      <span class="tool-name">{item.name}</span>
                      {item.context && (
                        <span class="tool-context">{item.context}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        ) : (
          <p class="skills-empty">No skill details have been added yet.</p>
        )
      }
    </div>
  </RetroWindow>
</ContentLayout>

<style>
  .drawer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--space-3);
  }

  .drawer {
    position: relative;
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    padding: calc(var(--space-3) + 8px) var(--space-3) var(--space-3);
    background: #fffef5;
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-raised);
  }

  .drawer::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 56px;
    height: 8px;
    background: var(--window);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-sunken);
  }

  .drawer-heading {
    display: flex;
    min-height: 54px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: var(--space-2);
    border-bottom: 1px dashed rgb(21 21 21 / 0.35);
  }

  .drawer-label {
    display: flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding-bottom: var(--space-2);
    font-family: var(--mono-font);
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    color: var(--primary);
  }

  .tool-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .content-page .tool-list > li + li {
    margin-top: 0;
  }

  .tool {
    display: flex;
    min-width: 0;
    min-height: 58px;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-2);
    background: var(--window);
    border: 1px solid var(--border-dark);
    box-shadow: var(--shadow-sunken);
  }

  .tool-name {
    font-family: var(--ui-font);
    font-size: 0.78rem;
    font-weight: bold;
    line-height: 1.3;
    color: var(--text-dark);
    overflow-wrap: anywhere;
  }

  .tool-context {
    margin-top: 2px;
    font-family: var(--mono-font);
    font-size: 0.62rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: rgb(21 21 21 / 0.62);
  }

  .drawer-focus {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.7fr);
    align-items: center;
    gap: var(--space-4);
    min-height: 112px;
    padding-left: var(--space-4);
    border-left: 4px solid var(--secondary);
    background: #f4f6f8;
  }

  .drawer-focus::before {
    right: var(--space-3);
    left: auto;
    transform: none;
  }

  .drawer-focus .drawer-heading {
    min-height: 0;
    align-items: flex-start;
    margin: 0;
    border: 0;
  }

  .drawer-kicker {
    margin-bottom: var(--space-1);
    font-family: var(--mono-font);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(21 21 21 / 0.62);
  }

  .drawer-focus .drawer-label {
    min-height: 0;
    justify-content: flex-start;
    padding: 0;
    text-align: left;
  }

  .drawer-focus .tool-list {
    grid-template-columns: minmax(0, 1fr);
  }

  .skills-empty {
    grid-column: 1 / -1;
    padding: var(--space-4);
    font-family: var(--mono-font);
    color: rgb(21 21 21 / 0.62);
    background: #fffef5;
    border: 1px dashed var(--border-dark);
  }

  @media (max-width: 900px) {
    .drawer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .drawer-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .drawer-focus {
      grid-column: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
  }
</style>
