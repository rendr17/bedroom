---
import { getCollection } from "astro:content";
import ContentLayout from "@/layouts/ContentLayout.astro";

const groups = await getCollection("skills");
---

<ContentLayout
  title="Skills"
  description="Rendi's skills grouped by practical capability — frontend, backend, integrations, AI-assisted development, and tooling."
>
  <p>
    Capabilities grouped by practical use — no percentage bars, just what I
    actually work with.
  </p>
  {
    groups.map((group) => (
      <section>
        <h2>{group.data.name}</h2>
        {group.data.items.length > 0 ? (
          <ul>
            {group.data.items.map((item) => (
              <li>
                {item.name}
                {item.context && (
                  <span class="project-meta"> — {item.context}</span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p>
            <em>Entries being prepared.</em>
          </p>
        )}
      </section>
    ))
  }
</ContentLayout>
