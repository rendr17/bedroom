---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TitleScreen from "@/components/adventure/TitleScreen.astro";
import RoomScene from "@/components/adventure/RoomScene.astro";
import QuestLog from "@/components/adventure/QuestLog.astro";
import AdventureBar from "@/components/adventure/AdventureBar.astro";
import { SITE } from "@/data/site";
---

<BaseLayout title={SITE.name} chrome="adventure">
  <TitleScreen />
  <h1 class="sr-only">{SITE.name}</h1>
  <RoomScene cover>
    <QuestLog slot="overlay" />
  </RoomScene>
  <AdventureBar slot="nav" />
</BaseLayout>
