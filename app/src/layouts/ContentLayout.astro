---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/data/site";

interface Props {
  title: string;
  heading?: string;
  description?: string;
}

const { title, heading = title, description } = Astro.props;
---

<BaseLayout title={`${title} — ${SITE.name}`} description={description}>
  <article class="content-page">
    <h1>{heading}</h1>
    <slot />
  </article>
</BaseLayout>
