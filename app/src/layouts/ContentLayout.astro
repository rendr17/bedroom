---
import SceneLayout from "@/layouts/SceneLayout.astro";

interface Props {
  title: string;
  heading?: string;
  description?: string;
}

const { title, heading = title, description } = Astro.props;
---

<SceneLayout
  title={title}
  windowTitle={`${title.toUpperCase()}.EXE`}
  description={description}
>
  <article class="content-page">
    <h1>{heading}</h1>
    <slot />
  </article>
</SceneLayout>
