---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { NAV_LINKS, SITE } from "@/data/site";

interface Props {
  title: string;
  windowTitle?: string;
  description?: string;
}

const { title, windowTitle = title, description } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
const railLinks = [
  { href: "/", label: "Home", icon: "/assets/props/avatar-placeholder.png" },
  ...NAV_LINKS,
  { href: "/extras", label: "Extras", icon: "/assets/icons/nav/extras.png" },
];
---

<BaseLayout
  title={`${title} — ${SITE.name}`}
  description={description}
  chrome="scene"
>
  <div class="scene-bg" aria-hidden="true">
    <img
      src="/assets/backgrounds/bedroom-night.png"
      alt=""
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
    />
  </div>
  <section class="scene-window" aria-label={windowTitle}>
    <header class="sw-titlebar">
      <img
        class="sw-icon"
        src="/assets/props/avatar-placeholder.png"
        alt=""
        width="18"
        height="18"
        aria-hidden="true"
      />
      <span class="sw-title">{windowTitle}</span>
      <div class="sw-controls">
        <span class="sw-control-symbol" aria-hidden="true">_</span>
        <span class="sw-control-symbol" aria-hidden="true">&#9634;</span>
        <a
          class="sw-control-close"
          href="/"
          aria-label="Close this page and return to the room"
          title="Close and return to the room"
        >
          &#10005;
        </a>
      </div>
    </header>
    <div class="sw-body">
      <nav class="sw-rail" aria-label="Sections">
        <ul>
          {
            railLinks.map(({ href, label, icon }) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent(href) ? "page" : undefined}
                >
                  <img
                    src={icon}
                    alt=""
                    width="24"
                    height="24"
                    aria-hidden="true"
                  />
                  <span class="sr-only">{label}</span>
                  <span class="rail-tip" aria-hidden="true">
                    {label}
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              class="sw-sound-toggle"
              id="sound-toggle"
              aria-pressed="false"
              data-cue
              hidden
            >
              <img
                src="/assets/icons/system/muted.png"
                alt=""
                width="24"
                height="24"
                aria-hidden="true"
              />
              <span class="sr-only">Toggle sound</span>
              <span class="rail-tip" aria-hidden="true">Sound</span>
            </button>
          </li>
        </ul>
      </nav>
      <div class="sw-content">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .scene-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
  }

  .scene-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    image-rendering: pixelated;
  }

  .scene-window {
    width: min(1180px, 100%);
    min-height: calc(100dvh - 24px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    background: var(--bg-deep);
    border: 1px solid var(--border-dark);
    box-shadow:
      var(--shadow-raised),
      var(--shadow-panel),
      0 0 48px rgb(0 0 0 / 0.55);
  }

  .sw-titlebar {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 3px var(--space-2) 3px var(--space-1);
    background: linear-gradient(90deg, var(--primary), var(--secondary) 160%);
    color: var(--text);
    font-family: var(--ui-font);
    font-size: 0.8rem;
    font-weight: bold;
    user-select: none;
  }

  .sw-icon {
    flex: none;
    width: 18px;
    height: 18px;
    object-fit: cover;
    object-position: top;
    image-rendering: pixelated;
    background: var(--window);
    border: 1px solid var(--border-dark);
  }

  .sw-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sw-controls {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-left: auto;
  }

  .sw-control-symbol,
  .sw-control-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 22px;
    height: 20px;
    font-family: var(--ui-font);
    font-size: 0.68rem;
    line-height: 1;
    color: var(--text-dark);
    background: var(--window);
    box-shadow:
      inset -1px -1px 0 var(--border-dark),
      inset 1px 1px 0 var(--border-light);
  }

  .sw-control-symbol {
    user-select: none;
  }

  .sw-control-close {
    border: 0;
    text-decoration: none;
    cursor: pointer;
  }

  .sw-control-close:hover {
    color: #fff;
    background: var(--danger);
  }

  .sw-control-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sw-control-close:active {
    box-shadow:
      inset 1px 1px 0 var(--border-dark),
      inset -1px -1px 0 var(--border-light);
  }

  .sw-body {
    min-height: calc(100dvh - 52px);
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
  }

  .sw-rail {
    position: sticky;
    top: var(--space-3);
    align-self: start;
    height: max-content;
    border-right: 1px solid var(--border-dark);
    background: rgb(15 23 42 / 0.85);
    z-index: 1;
  }

  .sw-rail ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2) var(--space-1);
    list-style: none;
  }

  .sw-rail a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-1);
    border: 1px solid transparent;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .sw-rail img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .sw-rail a:hover,
  .sw-rail a:focus-visible {
    background: var(--surface);
    border-color: var(--border-dark);
    box-shadow: var(--shadow-raised);
  }

  .sw-rail a:active {
    box-shadow: var(--shadow-sunken);
  }

  .sw-rail a[aria-current="page"] {
    background: var(--surface);
    border-color: var(--border-dark);
    box-shadow: var(--shadow-sunken);
  }

  .sw-rail a[aria-current="page"] img {
    filter: drop-shadow(0 0 5px rgb(255 209 102 / 0.7));
  }

  .sw-sound-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-1);
    color: var(--text);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .sw-sound-toggle img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .sw-sound-toggle:hover,
  .sw-sound-toggle:focus-visible,
  .sw-sound-toggle[aria-pressed="true"] {
    background: var(--surface);
    border-color: var(--border-dark);
    box-shadow: var(--shadow-raised);
  }

  .rail-tip {
    position: absolute;
    left: calc(100% + 8px);
    top: 50%;
    z-index: var(--z-tooltip);
    padding: 3px var(--space-2);
    font-family: var(--mono-font);
    font-size: 0.66rem;
    font-weight: bold;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-dark);
    background: var(--accent);
    border: 1px solid var(--border-dark);
    opacity: 0;
    transform: translateY(-50%) translateX(-4px);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .sw-rail a:hover .rail-tip,
  .sw-rail a:focus-visible .rail-tip,
  .sw-sound-toggle:hover .rail-tip,
  .sw-sound-toggle:focus-visible .rail-tip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .sw-content {
    min-width: 0;
    min-height: 0;
    padding: var(--space-6);
    background:
      radial-gradient(
        1px 1px at 8% 14%,
        rgb(255 209 102 / 0.9),
        transparent 2px
      ),
      radial-gradient(
        1px 1px at 22% 68%,
        rgb(244 241 232 / 0.7),
        transparent 2px
      ),
      radial-gradient(
        1.5px 1.5px at 35% 32%,
        rgb(255 209 102 / 0.8),
        transparent 2px
      ),
      radial-gradient(
        1px 1px at 47% 82%,
        rgb(244 241 232 / 0.6),
        transparent 2px
      ),
      radial-gradient(
        1.5px 1.5px at 58% 12%,
        rgb(255 209 102 / 0.85),
        transparent 2px
      ),
      radial-gradient(
        1px 1px at 66% 55%,
        rgb(244 241 232 / 0.7),
        transparent 2px
      ),
      radial-gradient(
        1px 1px at 78% 30%,
        rgb(255 209 102 / 0.8),
        transparent 2px
      ),
      radial-gradient(
        1.5px 1.5px at 88% 74%,
        rgb(244 241 232 / 0.65),
        transparent 2px
      ),
      radial-gradient(
        1px 1px at 94% 18%,
        rgb(255 209 102 / 0.75),
        transparent 2px
      ),
      radial-gradient(
        1px 1px at 15% 88%,
        rgb(244 241 232 / 0.6),
        transparent 2px
      ),
      var(--bg-deep);
  }

  @media (max-width: 640px), (max-height: 540px) {
    .sw-control-close {
      width: 44px;
      height: 44px;
    }

    .scene-window {
      min-height: calc(100dvh - 16px);
    }

    .sw-body {
      min-height: calc(100dvh - 68px);
      grid-template-columns: none;
      grid-template-rows: auto minmax(0, 1fr);
    }

    .sw-rail {
      top: var(--space-2);
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border-dark);
      overflow-y: hidden;
      overflow-x: auto;
    }

    .sw-rail ul {
      flex-direction: row;
      justify-content: safe center;
    }

    .sw-rail a,
    .sw-sound-toggle {
      flex-direction: column;
      gap: 2px;
      min-width: 60px;
      min-height: 56px;
      padding: var(--space-1);
    }

    .rail-tip {
      position: static;
      display: block;
      padding: 0;
      font-size: 0.55rem;
      font-weight: normal;
      letter-spacing: 0;
      color: var(--text);
      background: transparent;
      border: 0;
      opacity: 1;
      transform: none;
    }

    .sw-content {
      padding: var(--space-4) var(--space-3);
    }
  }
</style>

<script>
  import { isSoundEnabled, setSoundEnabled, playCue } from "@/utils/audio";

  const toggle = document.getElementById(
    "sound-toggle",
  ) as HTMLButtonElement | null;
  const icon = toggle?.querySelector("img");
  const render = () => {
    const enabled = isSoundEnabled();
    toggle?.setAttribute("aria-pressed", String(enabled));
    if (icon)
      icon.src = enabled
        ? "/assets/icons/system/sound.png"
        : "/assets/icons/system/muted.png";
  };

  toggle?.removeAttribute("hidden");
  render();
  toggle?.addEventListener("click", () => {
    setSoundEnabled(!isSoundEnabled());
    render();
    playCue("click");
  });
</script>
